            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=IIF(Parameters!Rubro.Value="PRU","Impuesto Predial Urbano",IIF(Parameters!Rubro.Value="MIL","1.5 por mil sobre activos totales","Patente Municipal")) &amp; "   ·   año base " &amp; Parameters!AnioBase.Value</Value>
                    <Style>
