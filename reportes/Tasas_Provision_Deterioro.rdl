                <TextRuns>
                  <TextRun>
                    <Value>TASAS DE PROVISIÓN POR DETERIORO DE CARTERA TRIBUTARIA</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>13pt</FontSize>
